{
  "name": "oasa-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "techtree": "node scripts/build-techtree.mjs",
    "dev": "npm run techtree && astro dev",
    "build": "npm run techtree && astro build",
    "preview": "astro preview",
    "techtree:sync": "node scripts/sync-techtree.mjs",
    "test": "node --test scripts/build-techtree.test.mjs",
    "oasa-files:test": "python3 -m unittest discover -s tools/oasa-files",
    "check:launch": "node scripts/check-launch.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview:cf": "npm run build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "apps:list": "wrangler d1 execute DB --remote --command \"SELECT id, created_at, status, name, city_state, age_group, guardian_consent FROM applications ORDER BY id DESC LIMIT 50\"",
    "apps:show": "node scripts/apps-show.mjs",
    "apps:set": "node scripts/apps-set.mjs",
    "apps:note": "node scripts/apps-note.mjs",
    "apps:score": "node scripts/apps-score.mjs",
    "apps:interview": "node scripts/apps-interview.mjs",
    "apps:due": "node scripts/apps-due.mjs",
    "apps:purge": "node scripts/apps-purge.mjs",
    "discord:setup": "node scripts/discord/setup.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "wrangler": "4.151.2"
  }
}
