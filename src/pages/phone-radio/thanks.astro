---
import Base from '../../layouts/Base.astro';
---
<Base title="You're on the waitlist" description="You joined the phone radio waitlist." noindex>
  <header class="page-head">
    <div class="wrap">
      <h1>You're on the waitlist</h1>
      <p class="lede">Thanks. We'll email you when there is something to see.</p>
    </div>
  </header>

  <div class="wrap section prose">
    <p>The phone radio is built in the open. You can follow the work, or help with it, on the tech tree.</p>
    <p class="actions"><a class="btn btn-primary" href="/techtree/#T-MSG1">See it on the tech tree</a><a class="btn btn-ghost" href="/phone-radio/">Back to the phone radio</a></p>
  </div>
</Base>
<style>
  .actions { margin-top: var(--space-6); }
</style>
