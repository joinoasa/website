---
import Base from '../../layouts/Base.astro';
import { site, contact, mailto } from '../../config/site';
import { stages } from '../../data/membership';

const membershipEmail = contact('membership');
---
<Base title="Application sent" description="Your OASA application arrived." noindex>
  <header class="page-head">
    <div class="wrap">
      <h1>Application sent</h1>
      <p class="lede">Thanks for applying. It arrived, and the founder reads every application personally.</p>
    </div>
  </header>

  <div class="wrap section prose">
    <h2 class="first">What happens next</h2>
    <ol>
      {stages.slice(1).map((st) => <li><strong>{st.title}.</strong> {st.body}</li>)}
    </ol>
    {site.membership.responseTime && <p>We aim to reply {site.membership.responseTime}.</p>}
    <p>If you're 15 to 17, we'll contact your parent or guardian for consent before your trial starts.</p>
    <p>Need to change something or add a link? Email <a href={mailto(membershipEmail, 'Update to my OASA application')}>{membershipEmail}</a>.</p>
    <p class="actions"><a class="btn btn-primary" href="/techtree/">Explore the tech tree</a><a class="btn btn-ghost" href="/docs/membership/">How membership works</a></p>
  </div>
</Base>
<style>
  .prose .first { margin-top: 0; }
  .actions { margin-top: var(--space-6); }
</style>
