---
import Base from '../../layouts/Base.astro';
import { roles, STATUS_LABEL, type Track } from '../../data/roles';

const tracks: Track[] = ['Build', 'Community', 'Coordination', 'Operations'];
const slug = (t: string) => t.toLowerCase();
---
<Base title="Open roles" description="Volunteer roles at OASA: researchers, engineers, web developers, moderators, coordinators and admins. Pick one and apply.">
  <header class="page-head">
    <div class="wrap">
      <h1>Open roles</h1>
      <p class="lede">Take on a job at OASA, alongside your own building or as your main way of helping. Pick a role and apply; your application says which one you want.</p>
      <p class="pay"><strong>All roles are volunteer for now.</strong> We plan to pay contributors as funding allows. <a href="#paid">More on pay</a></p>
    </div>
  </header>

  <div class="wrap section">
    <form class="filters" id="filters" role="search" hidden onsubmit="return false">
      <label>
        <span>Track</span>
        <select id="f-track">
          <option value="">All tracks</option>
          {tracks.map((t) => <option value={slug(t)}>{t}</option>)}
        </select>
      </label>
      <label>
        <span>Status</span>
        <select id="f-status">
          <option value="">Any status</option>
          {Object.entries(STATUS_LABEL).map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
      </label>
      <label class="grow">
        <span>Search</span>
        <input id="f-q" type="search" placeholder="Search roles" autocomplete="off" />
      </label>
      <p class="shown" id="f-count" aria-live="polite"></p>
    </form>

    {tracks.map((t) => {
      const list = roles.filter((r) => r.track === t);
      return (
        <section class="group" id={slug(t)} data-track={slug(t)}>
          <h2>{t} <span class="count" data-count>{list.length}</span></h2>
          <table class="jobs">
            <thead>
              <tr><th scope="col">Role</th><th scope="col">Who</th><th scope="col">Time</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Apply</span></th></tr>
            </thead>
            <tbody>
              {list.map((r) => (
                <tr id={r.slug} data-status={r.status} data-text={`${r.title} ${r.purpose} ${r.duties.join(' ')} ${r.fits ?? ''}`.toLowerCase()}>
                  <th scope="row"><a href={`/roles/${r.slug}/`}>{r.title}</a><span class="purpose">{r.purpose}</span></th>
                  <td data-label="Who">{r.who}</td>
                  <td data-label="Time">{r.hours}</td>
                  <td data-label="Status"><span class="status" data-s={r.status}>{STATUS_LABEL[r.status]}</span></td>
                  <td class="act">
                    {r.apply
                      ? <a class="btn btn-primary" href={`/join/apply/?role=${r.slug}`}>Apply<span class="visually-hidden"> for {r.title}</span></a>
                      : <a class="btn btn-ghost" href={`/roles/${r.slug}/`}>Details<span class="visually-hidden"> on {r.title}</span></a>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      );
    })}
    <p class="none" id="f-none" hidden>No roles match. <button type="button" class="link" id="f-reset">Clear the filters</button></p>

    <section class="more" id="how">
      <h2>How it works</h2>
      <ol class="steps">
        <li><strong>Not a member yet?</strong> Hit Apply. The form picks the role for you; the rest is the normal application.</li>
        <li><strong>Already a member?</strong> Ask an admin. Say which role and how many hours you can give.</li>
        <li>An admin checks the requirements, gives you the access the role needs and lists you as the holder. Your <a href="/docs/membership/#tiers">tier</a> doesn't change.</li>
        <li><strong>Stepping down is fine.</strong> Say so, and the access is removed the same day.</li>
      </ol>
      <p>Operations roles hold keys to our systems. Holders need a security key or passkey on every account, every change is logged, and a second person reviews changes once we have enough members.</p>
    </section>

    <section class="more" id="paid">
      <h2>Paid work later</h2>
      <p>OASA plans to become a nonprofit. When funding comes in, these roles are where paid work starts: first stipends, then part-time and full-time positions. Time you put in now counts.</p>
    </section>

    <div class="cta-strip">
      <p>Don't see your role? Apply anyway and tell us what you'd like to do.</p>
      <a class="btn btn-primary" href="/join/apply/">Apply to join</a>
    </div>
  </div>
</Base>

<script>
  const form = document.getElementById('filters') as HTMLFormElement;
  const track = document.getElementById('f-track') as HTMLSelectElement;
  const status = document.getElementById('f-status') as HTMLSelectElement;
  const q = document.getElementById('f-q') as HTMLInputElement;
  const count = document.getElementById('f-count')!;
  const none = document.getElementById('f-none')!;
  const groups = [...document.querySelectorAll<HTMLElement>('.group')];
  const total = document.querySelectorAll('.jobs tbody tr').length;

  // Filters live in the URL (?track=build&status=open&q=radio) so a filtered list can be shared.
  const params = new URLSearchParams(location.search);
  track.value = params.get('track') ?? '';
  status.value = params.get('status') ?? '';
  q.value = params.get('q') ?? '';

  function apply() {
    const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const g of groups) {
      let n = 0;
      g.querySelectorAll<HTMLElement>('tbody tr').forEach((row) => {
        const ok = (!track.value || g.dataset.track === track.value)
          && (!status.value || row.dataset.status === status.value)
          && words.every((w) => row.dataset.text!.includes(w));
        row.hidden = !ok;
        if (ok) n++;
      });
      g.hidden = n === 0;
      g.querySelector('[data-count]')!.textContent = String(n);
      shown += n;
    }
    none.hidden = shown > 0;
    count.textContent = shown === total ? `${total} roles` : `${shown} of ${total} roles`;
    const p = new URLSearchParams();
    if (track.value) p.set('track', track.value);
    if (status.value) p.set('status', status.value);
    if (q.value) p.set('q', q.value);
    history.replaceState(null, '', `${location.pathname}${p.size ? `?${p}` : ''}${location.hash}`);
  }
  form.hidden = false;
  form.addEventListener('input', apply);
  document.getElementById('f-reset')!.addEventListener('click', () => { form.reset(); apply(); q.focus(); });
  apply();
</script>

<style>
  .pay { margin-top: var(--space-3); color: var(--ink-soft); }
  .filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-3) var(--space-4); padding-bottom: var(--space-5); margin-bottom: var(--space-8); border-bottom: 1px solid var(--contour); }
  .filters[hidden], .group[hidden] { display: none; }
  .filters label { display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--step--1); font-weight: var(--weight-bold); color: var(--ink-muted); }
  .filters .grow { flex: 1 1 14rem; }
  .filters select, .filters input { min-height: 2.75rem; padding: 0 var(--space-3); border: 1px solid var(--line-control); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); font: inherit; font-size: var(--step-0); font-weight: var(--weight-regular); }
  .filters select:focus-visible, .filters input:focus-visible { border-color: var(--chart); }
  .shown { margin: 0 0 0 auto; font-size: var(--step--1); color: var(--ink-muted); align-self: center; }

  .group { margin-bottom: var(--space-12); scroll-margin-top: var(--space-4); }
  .group h2 { font-size: var(--step-3); display: flex; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-3); }
  .count { font-size: var(--step-0); font-weight: var(--weight-regular); color: var(--ink-muted); }

  .jobs { width: 100%; border-collapse: collapse; border-top: 2px solid var(--ink); table-layout: fixed; }
  /* Same column widths in every track's table, so the groups line up. */
  .jobs th:nth-child(1) { width: 46%; } .jobs th:nth-child(2) { width: 18%; } .jobs th:nth-child(3) { width: 12%; } .jobs th:nth-child(4) { width: 13%; } .jobs th:nth-child(5) { width: 11%; }
  .jobs thead th { text-align: left; font-size: var(--step--1); font-weight: var(--weight-bold); color: var(--ink-muted); padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--contour); }
  .jobs td, .jobs tbody th { padding: var(--space-4) var(--space-3); border-bottom: 1px solid var(--contour); vertical-align: middle; text-align: left; font-weight: var(--weight-regular); color: var(--ink-soft); }
  .jobs tbody tr:hover { background: var(--sky); }
  .jobs tbody tr:target { background: var(--accent-tint); }
  .jobs tbody th a { font-family: var(--font-display); font-weight: var(--weight-heading); font-size: var(--step-1); color: var(--ink); text-decoration: none; }
  .jobs tbody th a:hover { color: var(--chart-deep); text-decoration: underline; }
  .purpose { display: block; margin-top: var(--space-1); font-size: var(--step--1); color: var(--ink-muted); }
  .jobs .act { text-align: right; white-space: nowrap; }
  .status { font-size: var(--step--1); font-family: var(--font-display); font-weight: var(--weight-ui); padding: 0.15rem var(--space-2); border-radius: var(--radius-sm); border: 1px solid currentColor; white-space: nowrap; }
  .status[data-s='always'] { color: var(--available); }
  .status[data-s='open'] { color: var(--chart-deep); }
  .status[data-s='invite'] { color: var(--ink-muted); }

  .none { margin-bottom: var(--space-12); }
  .link { background: none; border: 0; padding: 0; font: inherit; color: var(--chart-deep); text-decoration: underline; cursor: pointer; }
  .more { margin-bottom: var(--space-10); }
  .more h2 { font-size: var(--step-2); }
  .steps { padding-left: 1.4em; max-width: var(--measure); }
  .steps li + li { margin-top: var(--space-2); }
  .more p { max-width: var(--measure); }

  /* Phones: each row becomes a small card. */
  @media (max-width: 720px) {
    .jobs thead { display: none; }
    .jobs, .jobs tbody, .jobs tr, .jobs td, .jobs tbody th { display: block; width: auto !important; }
    .jobs tbody tr { padding: var(--space-4) 0; border-bottom: 1px solid var(--contour); }
    .jobs tbody tr[hidden] { display: none; }
    .jobs td, .jobs tbody th { border: 0; padding: var(--space-1) 0; }
    .jobs td[data-label]::before { content: attr(data-label) ': '; font-weight: var(--weight-bold); color: var(--ink-muted); }
    .jobs td[data-label] { display: inline-block; margin-right: var(--space-4); font-size: var(--step--1); }
    .jobs .act { text-align: left; padding-top: var(--space-3); }
    .shown { margin-left: 0; }
  }
</style>
