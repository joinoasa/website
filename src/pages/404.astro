---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex description="The page you tried to open does not exist or may have moved. Go back to the OASA home page, explore the tech tree or read the documentation.">
  <header class="page-head">
    <div class="wrap">
      <h1>This page went off the map</h1>
      <p class="lede">The link may be old or mistyped. Try the home page, the tech tree or the docs.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href="/techtree/">Open the tech tree</a>
        <a class="btn btn-ghost" href="/docs/">Read the docs</a>
      </div>
    </div>
  </header>
</Base>
