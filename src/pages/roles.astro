---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { roles, STATUS_LABEL, type Track } from '../data/roles';

const tracks: { name: Track; blurb: string }[] = [
  { name: 'Build', blurb: 'Standing roles with room for everyone. Build the tech tree in your field.' },
  { name: 'Community', blurb: 'Keep OASA welcoming, sorted and moving.' },
  { name: 'Coordination', blurb: 'Lead the work from plan to done.' },
  { name: 'Operations', blurb: "Hold the keys to OASA's systems. By invite, after 30 days as a member." },
];
const applyHref = (slug: string) => `/join/apply/?role=${slug}`;
const discord = site.links.discord;
---
<Base title="Open roles" description="Volunteer roles at OASA: researchers, engineers, web developers, moderators, coordinators and admins. Pick one and apply.">
  <header class="page-head">
    <div class="wrap">
      <h1>Open roles</h1>
      <p class="lede">Take on a job at OASA, alongside your own building or as your main way of helping. Pick a role and apply; your application says which one you want.</p>
      <p class="pay"><strong>All roles are volunteer for now.</strong> We plan to pay contributors as funding allows. No dates or promises yet.</p>
    </div>
  </header>

  <div class="wrap section">
    <nav class="jump" aria-label="Tracks">
      {tracks.map((t) => <a href={`#${t.name.toLowerCase()}`}>{t.name} <span>{roles.filter((r) => r.track === t.name).length}</span></a>)}
    </nav>

    {tracks.map((t) => (
      <section class="track" id={t.name.toLowerCase()}>
        <h2>{t.name}</h2>
        <p class="track-blurb">{t.blurb}</p>
        <ul class="board">
          {roles.filter((r) => r.track === t.name).map((r) => (
            <li class="post" id={r.slug}>
              <div class="post-head">
                <h3>{r.title}</h3>
                <span class="status" data-s={r.status}>{STATUS_LABEL[r.status]}</span>
              </div>
              <ul class="meta">
                <li><span class="k">Who</span> {r.who}</li>
                <li><span class="k">Time</span> {r.hours}</li>
                <li><span class="k">Pay</span> Volunteer</li>
              </ul>
              <p class="purpose">{r.purpose}</p>
              <h4>What you'll do</h4>
              <ul class="duties">{r.duties.map((d) => <li>{d}</li>)}</ul>
              {r.fits && <p class="note"><strong>Good fit for:</strong> {r.fits}</p>}
              {r.needs && <p class="note"><strong>Needs:</strong> {r.needs}</p>}
              <div class="post-foot">
                {r.apply
                  ? <><a class="btn btn-primary" href={applyHref(r.slug)}>Apply for this role</a><span class="hint">Already a member? Ask an admin{discord ? <> on <a href={discord}>Discord</a></> : ''}.</span></>
                  : r.status === 'invite'
                  ? <span class="hint">By invite. Members are asked after 30 days, once we know each other.</span>
                  : <span class="hint">For {r.who}: ask an admin.</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="track" id="how">
      <h2>How it works</h2>
      <ol class="steps">
        <li><strong>Not a member yet?</strong> Hit "Apply for this role". The form picks the role for you; the rest is the normal application.</li>
        <li><strong>Already a member?</strong> Ask an admin. Say which role and how many hours you can give.</li>
        <li>An admin checks the requirements, gives you the access the role needs and lists you as the holder. Your <a href="/docs/membership/#tiers">tier</a> doesn't change.</li>
        <li><strong>Stepping down is fine.</strong> Say so, and the access is removed the same day.</li>
      </ol>
      <p>Operations roles hold keys to our systems. Holders need a security key or passkey on every account, every change is logged, and a second person reviews changes once we have enough members.</p>
    </section>

    <section class="track" id="paid">
      <h2>Paid work later</h2>
      <p>OASA plans to become a nonprofit. When funding comes in, these roles are where paid work starts: first stipends, then part-time and full-time positions. Time you put in now counts.</p>
    </section>

    <div class="cta-strip">
      <p>Don't see your role? Apply anyway and tell us what you'd like to do.</p>
      <a class="btn btn-primary" href="/join/apply/">Apply to join</a>
    </div>
  </div>
</Base>
<style>
  .pay { margin-top: var(--space-3); color: var(--ink-soft); }
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-8); }
  .jump a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 2.5rem; padding: 0 var(--space-3); border: 1px solid var(--line-control); border-radius: var(--radius-sm); background: var(--white); text-decoration: none; font-family: var(--font-display); font-weight: var(--weight-ui); color: var(--chart-deep); }
  .jump a:hover { border-color: var(--chart); color: var(--ink); }
  .jump span { color: var(--ink-muted); font-weight: var(--weight-regular); }
  .track { margin-bottom: var(--space-12); scroll-margin-top: var(--space-4); }
  .track h2 { font-size: var(--step-3); margin-bottom: var(--space-1); }
  .track-blurb { color: var(--ink-soft); margin-bottom: var(--space-5); }
  .board { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: var(--space-5); }
  .post { display: flex; flex-direction: column; padding: var(--space-5); background: var(--white); border: 1px solid var(--contour); border-top: 3px solid var(--chart); border-radius: var(--radius-sm); scroll-margin-top: var(--space-4); }
  .post:target { background: var(--accent-tint); border-top-color: var(--airspace); }
  .post-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }
  .post h3 { font-size: var(--step-2); font-stretch: var(--stretch-heading); font-weight: var(--weight-heading); margin: 0; }
  .status { flex: none; font-size: var(--step--1); font-family: var(--font-display); font-weight: var(--weight-ui); padding: 0.15rem var(--space-2); border-radius: var(--radius-sm); border: 1px solid currentColor; white-space: nowrap; }
  .status[data-s='always'] { color: var(--available); }
  .status[data-s='open'] { color: var(--chart-deep); }
  .status[data-s='invite'] { color: var(--ink-muted); }
  .meta { list-style: none; margin: var(--space-2) 0 var(--space-3); padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-size: var(--step--1); color: var(--ink-soft); }
  .k { color: var(--ink-muted); font-weight: var(--weight-bold); margin-right: 0.25em; }
  .purpose { margin-bottom: var(--space-3); }
  .post h4 { font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-muted); margin: 0 0 var(--space-1); }
  .duties { margin: 0 0 var(--space-3); padding-left: 1.2em; color: var(--ink-soft); }
  .duties li + li { margin-top: var(--space-1); }
  .note { font-size: var(--step--1); color: var(--ink-soft); margin-bottom: var(--space-2); }
  .post-foot { margin-top: auto; padding-top: var(--space-3); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .post-foot .hint { font-size: var(--step--1); color: var(--ink-muted); }
  .steps { padding-left: 1.4em; max-width: var(--measure); }
  .steps li + li { margin-top: var(--space-2); }
  #how p, #paid p { max-width: var(--measure); }
</style>
