---
import Base from '../layouts/Base.astro';
import TreeArt from '../components/home/TreeArt.astro';
import Panorama from '../components/home/Panorama.astro';
import { tally } from '../components/home/tree-layout.mjs';
import { layers } from '../components/descent/layers';
import tree from '../data/techtree.json';
import { stages } from '../data/membership';
import { nav } from '../config/site';

const counts = tally(tree.nodes);
const available = tree.nodes.filter((n) => n.status === 'available');
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const openHeading = available.length === 0 ? 'Start at the roots.'
  : available.length === 1 ? 'Start at the roots. One is open.'
  : `Start at the roots. These ${WORDS[available.length] ?? available.length} are open.`;
// "Basic radio link (off-the-shelf)" reads better in a list as "Basic radio link".
const short = (name: string) => name.split(/ \(|: /)[0];
const plural = (n: number, word: string) => `${word}${n === 1 ? '' : 's'}`;

const tiers = [
  ['Community partner', 'Listed publicly and works with OASA. No money required.'],
  ['Supporting partner', 'Sponsors OASA or donates parts.'],
  ['Strategic partner', 'Joint development under a long-term agreement.'],
];
const principles = [
  ['Encrypted, always', 'Every link, wired or wireless, is encrypted. We never set a standard that broadcasts to the world.'],
  ['Decentralized', 'No single server, company or person is required for the system to work.'],
  ['Works at every scale', 'The same system serves one person, a small team or a whole fleet.'],
  ['Affordable', 'Anyone can take part without multimillion-dollar gear.'],
  ['Sustainable', 'Designs are repairable, documented and built to keep running for years.'],
  ['Made in America', 'Designed and built in the U.S., with designs and security reviews published so anyone can check our work.'],
];
---
<Base title="Home" description="OASA is a member-built alliance designing open, encrypted drones, robots, boats and the mesh network that links them, for American communities." darkHeader>
  <div class="home">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <p class="eyebrow">Open Autonomous Systems Alliance</p>
          <h1>Dream big. Ship small.</h1>
          <p class="lede">A member-built community designing drones, robots, boats and the encrypted network that connects them. Every technology on our tree unlocks the next, from a basic radio link to a self-sustaining regional mesh.</p>
          <div class="actions">
            <a class="btn btn-primary" href={nav.apply.href}>{nav.apply.label}</a>
            <a class="btn btn-ghost" href="/partners/">Partner with us</a>
          </div>
          <ul class="key">
            <li><span class="dot dot-open"></span><span><strong>{counts.available}</strong> {counts.available === 1 ? 'technology' : 'technologies'} open to build right now</span></li>
            {counts['in-progress'] > 0 && <li><span class="dot dot-progress"></span><span><strong>{counts['in-progress']}</strong> being built</span></li>}
            {counts.done > 0 && <li><span class="dot dot-done"></span><span><strong>{counts.done}</strong> done</span></li>}
            <li><span class="dot dot-locked"></span><span><strong>{counts.locked}</strong> locked until what they need is done</span></li>
            <li><span class="dot dot-gold"></span><span><strong>{tree.moonshots.length}</strong> <a href="/moonshots/">{plural(tree.moonshots.length, 'moonshot')}</a> and <strong>{tree.starshots.length}</strong> {plural(tree.starshots.length, 'starshot')} they lead to</span></li>
          </ul>
        </div>
        <div class="hero-art"><TreeArt /></div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="open-head">
          <h2>{openHeading}</h2>
          <a class="btn btn-ghost" href="/techtree/">See the full tree</a>
        </div>
        {available.length > 0 && (
          <ul class="open-nodes">
            {available.map((n) => (
              <li><a href={`/techtree/#${n.id}`}><span class="nid">{n.id}</span><span>{short(n.name)}</span></a></li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section class="world">
      <div class="wrap world-head">
        <p class="eyebrow">What the tree grows into</p>
        <h2>One encrypted network, from orbit to the ocean floor.</h2>
        <p class="lede">From a balloon at the edge of space to a sub on the riverbed, every system is designed to share one encrypted mesh and show up on the same map.</p>
        <p><a class="text-link descend" href="/descent/">Take the full descent, layer by layer
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v15M6 13l6 6 6-6" /></svg></a></p>
      </div>
      <Panorama />
      <div class="wrap">
        <ul class="layers">
          {layers.map((l) => (
            <li>
              <h3>{l.name}</h3>
              <p class="range">{l.range}</p>
              <p>{l.intro}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Two ways in.</h2>
        <div class="ways">
          <div class="card">
            <p class="eyebrow">For builders</p>
            <h3>Join as a member</h3>
            <p>Apply here, or ask any member to invite you. Teams and school cohorts can apply together. A formal portfolio isn’t required. Raw ability counts.</p>
            <ol class="steps">
              {stages.map((st) => (<li>{st.title}</li>))}
            </ol>
            <div class="actions card-actions">
              <a class="btn btn-primary" href={nav.apply.href}>{nav.apply.label}</a>
              <a class="text-link" href="/roles/">See open roles</a>
            </div>
          </div>
          <div class="card card-light">
            <p class="eyebrow">For partners and sponsors</p>
            <h3>Back open, encrypted autonomy</h3>
            <p>OASA works with makerspaces, schools, manufacturers, utilities and others who want open, encrypted autonomous systems to succeed.</p>
            <ul class="tiers">
              {tiers.map(([t, b]) => (<li><strong>{t}.</strong> {b}</li>))}
            </ul>
            <div class="actions card-actions">
              <a class="btn btn-navy" href="/partners/">Partner with us</a>
            </div>
            <p class="fine">Partners never control OASA standards or direction.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="how">
      <div class="wrap how-grid">
        <div>
          <h2>How we work.</h2>
          <p class="lede">These principles shape every project, standard and line of code.</p>
          <p><a class="text-link" href="/docs/principles/">Read all principles</a></p>
        </div>
        <ul class="principles">
          {principles.map(([t, b]) => (<li><h3>{t}</h3><p>{b}</p></li>))}
        </ul>
      </div>
    </section>

    <section class="closing">
      <div class="wrap closing-row">
        <h2>Ready to build with us?</h2>
        <div class="actions">
          <a class="btn btn-navy" href={nav.apply.href}>{nav.apply.label}</a>
          <a class="btn btn-outline-navy" href="/partners/">Partner with us</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* The home page is dark from the header down. --home-deep sits a step below the brand navy so navy bands read against it. */
  .home {
    --home-deep: #071726; --rule: rgb(255 255 255 / 0.14); --open: #6fd0c3; --locked: #7391bd;
    --focus: var(--focus-on-dark);
    background: var(--home-deep); color: var(--on-dark-body);
    margin-bottom: calc(-1 * var(--space-8)); /* meet the footer with no paper gap */
  }
  section { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .band { background: var(--navy); border-block: 1px solid rgb(255 255 255 / 0.08); }
  h1, h2, h3 { color: var(--on-dark); }
  h2 { font-size: clamp(1.75rem, 3.2vw, 2.5rem); }
  p { color: var(--on-dark-muted); }
  a { color: var(--on-dark); }
  a:hover { color: var(--on-dark); }
  .lede { color: var(--on-dark-muted); font-size: 1.125rem; line-height: 1.6; }
  .eyebrow { margin: 0 0 var(--space-4); font-family: var(--font-display); font-weight: var(--weight-ui); font-size: var(--step--1); letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal-on-dark); }
  .btn-ghost { color: var(--on-dark); border-color: var(--chart-on-dark); }
  .btn-ghost:hover { background: var(--surface-dark-hover); color: var(--on-dark); }
  .btn-navy { background: var(--navy); border-color: var(--navy); color: var(--white); }
  .btn-navy:hover { background: var(--steel); border-color: var(--steel); color: var(--white); }
  .btn-outline-navy { background: transparent; border-color: var(--navy); color: var(--navy); }
  .btn-outline-navy:hover { background: rgb(11 37 58 / 0.12); color: var(--navy); }
  .text-link { font-weight: var(--weight-bold); }

  /* Hero */
  .hero { padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 4.5rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: var(--space-10) clamp(var(--space-8), 4vw, 3.5rem); align-items: center; }
  h1 { font-size: clamp(2.625rem, 6vw, 5.125rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; margin-bottom: var(--space-6); }
  .hero .lede { margin-bottom: var(--space-6); }
  .hero-art { display: flex; justify-content: center; }
  .hero-art :global(svg) { max-width: 40rem; }
  .key { list-style: none; margin: var(--space-8) 0 0; padding: var(--space-6) 0 0; border-top: 1px solid var(--rule); display: grid; gap: var(--space-2); font-size: 0.9375rem; }
  .key li { display: flex; align-items: center; gap: var(--space-3); }
  .key strong { color: var(--on-dark); }
  .dot { flex: none; width: 0.875rem; height: 0.875rem; border-radius: 50%; }
  .dot-open { background: var(--open); }
  .dot-progress { border: 3px solid var(--open); }
  .dot-done { background: var(--white); }
  .dot-locked { background: var(--locked); }
  .dot-gold { background: var(--gold); }

  /* Open technologies */
  .open-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4) var(--space-10); margin-bottom: var(--space-6); }
  .open-head h2 { margin: 0; }
  .open-nodes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3.5rem; border-top: 1px solid var(--rule); }
  .open-nodes li { border-bottom: 1px solid var(--rule); }
  .open-nodes a { display: flex; align-items: center; gap: var(--space-3); min-height: 3.125rem; padding-block: var(--space-1); text-decoration: none; }
  .open-nodes a:hover span:last-child { text-decoration: underline; }
  .nid { flex: none; min-width: 5.25rem; font-family: var(--font-display); font-weight: var(--weight-heading); color: var(--teal-on-dark); }

  /* One network: the panorama and its six layers */
  .world { padding-bottom: clamp(3rem, 7vw, 5.5rem); }
  .world-head { padding-bottom: var(--space-4); }
  .world-head h2 { max-width: 18em; }
  .descend { gap: var(--space-2); font-family: var(--font-display); }
  .layers { list-style: none; margin: var(--space-10) 0 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-8) var(--space-6); }
  .layers li { border-top: 2px solid var(--gold); padding-top: var(--space-3); }
  .layers h3 { font-size: 1.1875rem; font-weight: var(--weight-heading); margin: 0; }
  .layers p { font-size: var(--step--1); line-height: 1.5; margin: var(--space-2) 0 0; }
  .layers .range { font-size: 0.8125rem; margin-top: var(--space-1); }

  /* Two ways in */
  .ways { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-8); }
  .card { display: flex; flex-direction: column; align-items: flex-start; background: var(--home-deep); border: 1px solid var(--rule); border-radius: 14px; padding: clamp(var(--space-6), 3vw, 2.25rem); }
  .card h3 { font-size: 1.75rem; font-weight: var(--weight-heading); line-height: 1.2; }
  .card .eyebrow { margin-bottom: var(--space-3); }
  .card-actions { align-items: center; gap: var(--space-3) var(--space-6); margin-top: auto; padding-top: var(--space-6); }
  .steps { list-style: none; counter-reset: s; margin: var(--space-2) 0 0; padding: 0; align-self: stretch; display: grid; gap: var(--space-3); font-size: 0.9375rem; color: var(--on-dark-body); }
  .steps li { counter-increment: s; display: flex; align-items: center; gap: var(--space-3); }
  .steps li::before { content: counter(s); flex: none; width: 1.625rem; height: 1.625rem; border-radius: 50%; display: grid; place-items: center; background: #1f5f8a; color: var(--white); font-family: var(--font-display); font-weight: var(--weight-heading); font-size: 0.8125rem; }
  .card-light { --focus: var(--airspace); background: var(--aluminum); border-color: var(--aluminum); color: var(--ink-soft); }
  .card-light h3 { color: var(--navy); }
  .card-light p { color: var(--ink-soft); }
  .card-light .eyebrow { color: var(--available); }
  .card-light .card-actions { margin-top: 0; }
  .card-light .fine { font-size: var(--step--1); color: var(--ink-muted); margin: var(--space-4) 0 0; }
  .tiers { list-style: none; margin: var(--space-2) 0 0; padding: 0; align-self: stretch; font-size: 0.9375rem; line-height: 1.5; border-bottom: 1px solid rgb(11 37 58 / 0.18); }
  .tiers li { padding-block: var(--space-3); border-top: 1px solid rgb(11 37 58 / 0.18); }
  .tiers strong { color: var(--navy); }

  /* How we work */
  .how-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-10) var(--space-16); }
  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-10); align-content: start; }
  .principles li { padding-block: var(--space-4); border-top: 1px solid var(--rule); }
  .principles h3 { font-size: 1.0625rem; font-weight: var(--weight-heading); margin-bottom: var(--space-1); }
  .principles p { font-size: 0.9375rem; line-height: 1.5; margin: 0; }

  /* Closing */
  .closing { --focus: var(--navy); background: var(--gold); padding-block: var(--space-16); }
  .closing-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6) var(--space-10); }
  .closing h2 { color: var(--navy); font-weight: 800; font-size: clamp(1.75rem, 3.4vw, 2.75rem); margin: 0; }

  @media (max-width: 1100px) {
    .layers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .hero-grid, .ways, .how-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .open-nodes { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .principles { grid-template-columns: 1fr; }
    .layers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media print {
    .home { background: none; color: var(--ink); margin-bottom: 0; }
    .home :is(h1, h2, h3, p, a, strong, .nid, .eyebrow) { color: var(--ink) !important; }
    .band, .closing, .card { background: none !important; }
  }
</style>
