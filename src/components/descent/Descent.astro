---
// "The Descent": the home page hero. Scroll from space to underwater.
// Each layer is one screen of text beside its scene. The scene column is sticky,
// so it holds still when the text is taller than the screen. Layers scroll
// continuously. A mesh "thread" runs through the hub node of every layer.
import { layers } from './layers';
import Node from './Node.astro';
import SpaceScene from './scenes/SpaceScene.astro';
import SkyScene from './scenes/SkyScene.astro';
import MountainsScene from './scenes/MountainsScene.astro';
import GroundScene from './scenes/GroundScene.astro';
import SeaScene from './scenes/SeaScene.astro';
import UnderwaterScene from './scenes/UnderwaterScene.astro';
import './art.css';

const scenes: Record<string, any> = { space: SpaceScene, sky: SkyScene, mountains: MountainsScene, ground: GroundScene, sea: SeaScene, underwater: UnderwaterScene };
---
<div class="descent" id="descent">
  <script is:inline>(function(){var d=document.getElementById('descent');d.classList.add('js');setTimeout(function(){if(!d.hasAttribute('data-ready'))d.classList.remove('js');},2500);})();</script>
  {layers.map((layer, li) => {
    const byId = Object.fromEntries(layer.nodes.map((n) => [n.id, n]));
    const isFirst = li === 0;
    const Scene = scenes[layer.id];
    return (
      <section class:list={['layer', `layer-${layer.id}`, { dark: layer.dark }]} data-layer={layer.id} id={`layer-${layer.id}`} aria-labelledby={`h-${layer.id}`}>
        <div class="wrap layer-grid">
          {isFirst && (
            <div class="step step-intro">
              <h1>Autonomous systems from orbit to the ocean floor, built in the open.</h1>
              <p class="lede">The Open Autonomous Systems Alliance is a member-built community designing drones, robots, boats and the encrypted network that connects them, to make American communities better, cleaner and safer.</p>
              <div class="ctas">
                <a class="btn btn-primary" href="/join/">Apply to join</a>
                <a class="btn btn-ghost" href="/techtree/">Explore the tech tree</a>
              </div>
              <p class="cue">Scroll to descend through every layer we work in.</p>
            </div>
          )}

          <div class="step">
            <div class="layer-head">
              <h2 id={`h-${layer.id}`}>{layer.name}</h2>
              <p class="range">{layer.range}</p>
            </div>
            <p class="intro">{layer.intro}</p>
            <ul class="examples">
              {layer.examples.map(([t, b]) => (<li><strong>{t}:</strong> {b}</li>))}
            </ul>
          </div>

          <div class="art">
            <svg viewBox="0 0 600 700" role="img" aria-label={`${layer.name}: ${layer.nodes.map((n) => n.label).join(', ')}`}>
              <defs>
                <linearGradient id={`fg-${layer.id}`} gradientUnits="userSpaceOnUse" x1="-120" y1="0" x2="60" y2="0">
                  <stop offset="0" stop-color="#000" /><stop offset="1" stop-color="#fff" />
                </linearGradient>
                <mask id={`fade-${layer.id}`} maskUnits="userSpaceOnUse" x="-2000" y="-2000" width="5000" height="5000">
                  <rect x="-2000" y="-2000" width="5000" height="5000" fill={`url(#fg-${layer.id})`} />
                </mask>
              </defs>
              <Scene part="back" layer={layer} />

              <g class="thread" aria-hidden="true">
                {layer.threadTop !== 'none' && <line x1="300" y1="-1600" x2="300" y2="350" pathLength="1" class:list={['t-line', 't-top', layer.threadTop]} />}
                {layer.threadBottom !== 'none' && <line x1="300" y1="350" x2="300" y2="2300" pathLength="1" class:list={['t-line', 't-bottom', layer.threadBottom]} />}
              </g>

              <g class="links">
                {layer.links.map(([a, b, kind], i) => (
                  <line x1={byId[a].x} y1={byId[a].y} x2={byId[b].x} y2={byId[b].y} pathLength="1"
                    class:list={['link', kind ?? 'mesh']} style={isFirst ? `--d:${0.2 + i * 0.12}s` : undefined} />
                ))}
              </g>

              <g class="pulses" aria-hidden="true">
                {(layer.pulses ?? []).map(([a, b], i) => {
                  const kind = layer.links.find(([x, y]) => (x === a && y === b) || (x === b && y === a))?.[2] ?? 'mesh';
                  return (
                    <>
                      <line x1={byId[a].x} y1={byId[a].y} x2={byId[b].x} y2={byId[b].y} pathLength="1" class:list={['pulse', 'pulse-o', kind]} style={`--i:${i}`} />
                      <line x1={byId[a].x} y1={byId[a].y} x2={byId[b].x} y2={byId[b].y} pathLength="1" class="pulse pulse-i" style={`--i:${i}`} />
                    </>
                  );
                })}
              </g>

              <g class="nodes">
                {layer.nodes.map((n, i) => <Node node={n} index={i} delay={isFirst ? `${0.1 + i * 0.08}s` : undefined} />)}
              </g>
              <Scene part="front" layer={layer} />
            </svg>
          </div>
        </div>
      </section>
    );
  })}

  <nav class="gauge" aria-label="Jump to a layer">
    <ol>
      {layers.map((l) => (<li data-for={l.id}><a href={`#layer-${l.id}`}><span class="g-alt">{l.gauge}</span><span class="g-name">{l.name}</span></a></li>))}
    </ol>
  </nav>
</div>

<section class="surface">
  <div class="wrap">
    <h2>One encrypted network ties every layer together.</h2>
    <p class="lede">From a balloon at the edge of space to a sub on the riverbed, every system is designed to share one encrypted mesh and show up on the same map, whether it is one person with one drone or a fleet of hundreds.</p>
    <div class="ctas">
      <a class="btn btn-primary" href="/join/">Apply to join</a>
      <a class="btn btn-ghost" href="/moonshots/">See the moonshots</a>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('descent')!;
  const layerEls = [...root.querySelectorAll<HTMLElement>('.layer')];
  const gauge = root.querySelector<HTMLElement>('.gauge')!;
  const gaugeItems = [...gauge.querySelectorAll<HTMLElement>('li')];

  // Reveal each layer's network as it arrives.
  const reveal = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('on'); reveal.unobserve(e.target); }
  }, { threshold: 0.15 });
  layerEls.forEach((el) => reveal.observe(el));

  // Track the layer at the middle of the screen for the altitude gauge.
  const active = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const id = (e.target as HTMLElement).dataset.layer;
      gaugeItems.forEach((li) => {
        const cur = li.dataset.for === id;
        li.classList.toggle('current', cur);
        const a = li.querySelector('a')!;
        if (cur) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
      });
      gauge.classList.toggle('on-dark', e.target.classList.contains('dark'));
    }
  }, { rootMargin: '-50% 0px -50% 0px' });
  layerEls.forEach((el) => active.observe(el));

  // Show the gauge only while the descent is on screen.
  new IntersectionObserver(([e]) => gauge.classList.toggle('show', e.isIntersecting && e.intersectionRatio >= 0.01), { threshold: [0, 0.01] }).observe(root);

  // Animate only the layer(s) on screen: art.css pauses everything else.
  const live = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-live', e.isIntersecting);
  }, { threshold: 0 });
  layerEls.forEach((el) => live.observe(el));

  root.dataset.ready = '';
</script>

<style>
  .descent { position: relative; }
  .layer { position: relative; color: var(--ink); overflow: clip; }
  .layer.dark { color: var(--on-dark-body); --focus: var(--focus-on-dark); }
  .layer-space { background: linear-gradient(#0b1630 0%, #13284f 70%, #2c4f86 100%); }
  .layer-sky { background: linear-gradient(#2c4f86 0%, #7fa8de 22%, #dceaf6 100%); }
  .layer-mountains { background: linear-gradient(#dceaf6, #eef3f6); }
  .layer-ground { background: linear-gradient(#eef3f6, #e6eee0); }
  .layer-sea { background: linear-gradient(#e6eee0 0%, #eaf2f8 45%, #9cc0e2 100%); }
  .layer-underwater { background: linear-gradient(#9cc0e2 0%, #2e4f80 30%, #13233f 100%); }

  .layer-space::after, .layer-sky::after, .layer-mountains::after, .layer-ground::after, .layer-sea::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 14vh; z-index: 1; pointer-events: none; }
  .layer-sky::after { background: linear-gradient(rgba(220, 234, 246, 0), #dceaf6); }
  .layer-underwater::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 12vh; z-index: 2; pointer-events: none; background: linear-gradient(#9cc0e2, rgba(156, 192, 226, 0)); }
  .layer-mountains::after { background: linear-gradient(rgba(238, 243, 246, 0), #eef3f6); }
  .layer-ground::after { background: linear-gradient(rgba(230, 238, 224, 0), #e6eee0); }
  /* Blend the Earth and sea fills into the next layer's top color so there is no hard seam. */
  .layer-space::after { background: linear-gradient(rgba(44, 79, 134, 0), #2c4f86); }
  .layer-sea::after { height: 10vh; background: linear-gradient(rgba(156, 192, 226, 0), #9cc0e2); }
  .layer-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: clamp(1.5rem, 4vw, 3.5rem); }
  .step { grid-column: 1; position: relative; z-index: 2; min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: var(--space-16); }
  .art { grid-column: 2; grid-row: 1 / span 2; align-self: start; position: sticky; top: 0; height: 100vh; height: 100svh; display: grid; place-items: center; z-index: 1; }
  .art svg { width: 100%; height: 100%; max-height: 92vh; overflow: visible; }

  /* Headline step */
  .step-intro h1 { font-size: var(--step-hero); max-width: 20ch; color: var(--on-dark); }
  .step-intro .lede { color: var(--on-dark-muted); }
  @media (min-width: 861px) { .step-intro h1 { max-width: 24ch; margin-right: calc(-1 * clamp(0rem, 8vw, 9rem)); } }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .dark .btn-ghost, .surface .btn-ghost { color: var(--on-dark); border-color: var(--chart-on-dark); }
  .dark .btn-ghost:hover, .surface .btn-ghost:hover { background: var(--surface-dark-hover); color: var(--on-dark); }
  .cue { margin-top: var(--space-6); font-size: var(--step--1); color: var(--on-dark-muted); }

  /* Layer text */
  .layer-head { display: grid; justify-items: start; row-gap: var(--space-1); margin-bottom: var(--space-4); }
  .layer-head h2 { margin: 0; font-size: var(--step-layer); font-stretch: var(--stretch-layer); }
  .range { margin: 0; font-family: var(--font-display); font-stretch: var(--stretch-condensed); font-weight: var(--weight-ui); font-size: var(--step-0); color: var(--chart-deep); }
  .dark .range { color: var(--on-dark-muted); }
  .layer-sky .range { color: var(--ink); }
  .layer-sky .intro { color: var(--ink); }
  .intro { font-size: var(--step-1); line-height: var(--leading-lede); color: var(--ink-soft); }
  .dark .intro { color: var(--on-dark-muted); }
  .examples { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: grid; gap: var(--space-2); max-width: 34rem; }
  .examples li { position: relative; padding-left: var(--space-6); line-height: var(--leading-lede); }
  .examples li::before { content: ''; position: absolute; left: 0.125rem; top: 0.5em; width: 0.625rem; height: 0.625rem; border: 2px solid var(--chart); border-radius: 50%; background: var(--white); }
  .dark .examples li { color: var(--on-dark-body); }
  .dark .examples li::before { border-color: var(--chart-on-dark); background: transparent; }
  .dark .examples strong { color: var(--on-dark); }

  /* Altitude gauge */
  .gauge { position: fixed; right: max(0.75rem, calc((100vw - 72rem) / 2 - 1.5rem)); background: rgba(246, 249, 251, 0.88); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); top: 50%; transform: translateY(-50%); z-index: 5; opacity: 0; pointer-events: none; visibility: hidden; transition: opacity var(--dur-state) var(--ease-out), visibility 0s linear var(--dur-state); }
  .gauge.show { opacity: 1; visibility: visible; transition-delay: 0s; }
  .gauge a { pointer-events: auto; display: grid; justify-items: end; min-height: 2rem; text-decoration: none; color: inherit; }
  .gauge a:hover { color: var(--ink); }
  .gauge.on-dark a:hover { color: var(--on-dark); }
  .gauge.on-dark { --focus: var(--focus-on-dark); }
  .gauge ol { list-style: none; margin: 0; padding: 0.6rem 0; border-right: 2px solid rgba(19, 35, 63, 0.25); display: grid; gap: 0.9rem; }
  .gauge li { display: grid; justify-items: end; padding-right: 0.75rem; position: relative; color: var(--ink-muted); line-height: 1.15; }
  .gauge li::after { content: ''; position: absolute; right: -6px; top: 0.35rem; width: 10px; height: 2px; background: currentColor; }
  .gauge .g-alt { font-family: var(--font-display); font-stretch: 90%; font-weight: 700; font-size: 1rem; }
  .gauge .g-name { font-size: 0.875rem; }
  .gauge li.current { color: var(--ink); }
  .gauge li.current::after { width: 14px; right: -8px; background: var(--airspace); }
  .gauge.on-dark { background: rgba(11, 22, 48, 0.6); }
  .gauge.on-dark ol { border-right-color: rgba(255, 255, 255, 0.3); }
  .gauge.on-dark li { color: rgba(255, 255, 255, 0.7); }
  .gauge.on-dark li.current { color: var(--on-dark); }
  .gauge.on-dark li.current::after { background: var(--accent-on-dark); }

  .surface { --focus: var(--focus-on-dark); background: var(--ink); color: var(--on-dark-body); padding-block: clamp(3rem, 8vw, 5.5rem); }
  .surface h2 { color: var(--on-dark); max-width: 20ch; }
  .surface .lede { color: var(--on-dark-muted); }

  @media (min-width: 1101px) { .art { padding-right: 4.5rem; } }
  @media (max-width: 1100px) { .gauge { display: none; } }
  @media print {
    .descent .art, .gauge { display: none; }
    .layer, .surface { background: none !important; color: var(--ink) !important; }
    .layer .step { min-height: 0; padding-block: var(--space-6); }
    .descent h1, .descent h2, .descent .intro, .descent .examples li, .descent .examples strong, .descent .range, .surface h2, .surface .lede, .cue { color: var(--ink) !important; }
    .ctas { display: none; }
  }
  @media (min-width: 861px) and (max-height: 820px) { .step { padding-block: var(--space-8); } }

  @media (max-width: 860px) {
    .layer-sky { background: linear-gradient(#2c4f86 0%, #9cc0e2 6%, #dceaf6 100%); }
    .layer-underwater { background: linear-gradient(#9cc0e2 0%, #2e4f80 8%, #13233f 100%); }
    .layer-grid { grid-template-columns: 1fr; }
    .step { min-height: auto; padding-block: var(--space-12) var(--space-4); }
    .step-intro { min-height: 88svh; }
    .art { grid-column: 1; grid-row: auto; position: static; height: auto; padding-bottom: var(--space-10); }
    .art svg { height: auto; max-height: none; }
  }
</style>
