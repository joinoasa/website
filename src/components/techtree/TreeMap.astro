---
// Game-style tech tree: roots on the left, moonshots on the right, one lane per branch.
// Columns are dependency depth (a node sits one step right of its deepest requirement).
// Layout is computed here at build time; the client script only pans, zooms and opens popups.
import tree from '../../data/techtree.json';
import { site, nav } from '../../config/site';

interface Props { order: string[] }
const { order } = Astro.props;

const NODE_W = 200;
const NODE_H = 56;
const COL_W = 252;
const ROW_H = 68;
const LANE_HEAD = 40;
const LANE_GAP = 20;
const LEFT = 32;
const TOP = 56;
const MS_GAP = 14; // minimum space between two moonshot cards

type N = (typeof tree.nodes)[number];
const byId = new Map<string, N>(tree.nodes.map((n) => [n.id, n]));
const parentsOf = (n: N) => n.requires.filter((id) => byId.has(id));

// Build-time guard: a node whose branch is missing from `order` would never get a position.
for (const n of tree.nodes) {
  if (!order.includes(n.branch)) throw new Error(`TreeMap: node ${n.id} has branch "${n.branch}", which is not in the page's ORDER list (src/pages/techtree.astro). Add it there.`);
}

// Depth = longest chain of requirements.
const depth = new Map<string, number>();
function d(id: string, seen = new Set<string>()): number {
  if (depth.has(id)) return depth.get(id)!;
  if (seen.has(id)) return 0; // cycle guard; the build script already rejects cycles
  seen.add(id);
  const ps = parentsOf(byId.get(id)!);
  const v = ps.length ? 1 + Math.max(...ps.map((p) => d(p, seen))) : 0;
  depth.set(id, v);
  return v;
}
tree.nodes.forEach((n) => d(n.id));
const maxDepth = Math.max(...depth.values());
const slugOf = (name: string) => name.toLowerCase().replace(/[^a-z]+/g, '-');

// Lanes: one per branch, as tall as its busiest column. The counts feed the lane label.
const lanes = order.filter((b) => tree.nodes.some((n) => n.branch === b)).map((name) => {
  const nodes = tree.nodes.filter((n) => n.branch === name);
  const perCol = new Map<number, N[]>();
  nodes.forEach((n) => { const c = depth.get(n.id)!; perCol.set(c, [...(perCol.get(c) ?? []), n]); });
  const rows = Math.max(...[...perCol.values()].map((v) => v.length));
  const count = (s: string) => nodes.filter((n) => n.status === s).length;
  const progress = [`${count('done')} of ${nodes.length} done`, count('available') && `${count('available')} ready`, count('in-progress') && `${count('in-progress')} in progress`].filter(Boolean).join(' · ');
  return { name, slug: slugOf(name), perCol, rows, progress, top: 0, height: 0 };
});
let y = TOP;
for (const l of lanes) {
  l.top = y;
  l.height = LANE_HEAD + l.rows * ROW_H;
  y += l.height + LANE_GAP;
}
const treeBottom = y;
const laneIndex = new Map(lanes.map((l, i) => [l.name, i]));

// Place column by column so every node's parents already have a position.
// Each node aims for the average height of its parents (fewer crossing lines).
const pos = new Map<string, { x: number; y: number }>();
const centerY = (id: string) => pos.get(id)!.y + NODE_H / 2;
for (let col = 0; col <= maxDepth; col++) {
  for (const l of lanes) {
    const group = l.perCol.get(col);
    if (!group) continue;
    const slots0 = l.top + LANE_HEAD;
    const want = (n: N) => {
      const ps = parentsOf(n);
      if (!ps.length) return 0;
      const avg = ps.reduce((a, p) => a + centerY(p), 0) / ps.length;
      return Math.round((avg - NODE_H / 2 - slots0) / ROW_H);
    };
    const sorted = group.map((n) => ({ n, w: want(n) })).sort((a, b) => a.w - b.w);
    const rows: number[] = [];
    sorted.forEach((s, i) => rows.push(Math.max(i === 0 ? 0 : rows[i - 1] + 1, Math.min(Math.max(s.w, 0), l.rows - 1))));
    // Pull back up if the group ran past the bottom of the lane.
    for (let i = rows.length - 1; i >= 0; i--) rows[i] = Math.min(rows[i], (i === rows.length - 1 ? l.rows : rows[i + 1]) - 1);
    sorted.forEach((s, i) => pos.set(s.n.id, { x: LEFT + col * COL_W, y: slots0 + rows[i] * ROW_H }));
  }
}

// Moonshots: a column on the far right. Each sits as near as it can to the nodes it needs,
// pushed down just enough that two cards never overlap (no even spread).
const MS_X = LEFT + (maxDepth + 1) * COL_W + 48;
const nodeIdsOf = (m: (typeof tree.moonshots)[number]) => m.builds.filter((id) => pos.has(id));
const shots = tree.moonshots
  .map((m) => {
    const ids = nodeIdsOf(m);
    const avg = ids.length ? ids.reduce((a, id) => a + centerY(id), 0) / ids.length : TOP + LANE_HEAD;
    return { m, want: avg - NODE_H / 2 };
  })
  .sort((a, b) => a.want - b.want);
{
  let last = TOP + LANE_HEAD - NODE_H - MS_GAP;
  for (const s of shots) {
    const yy = Math.round(Math.max(s.want, last + NODE_H + MS_GAP, TOP + LANE_HEAD));
    pos.set(s.m.id, { x: MS_X, y: yy });
    last = yy;
  }
}
const width = MS_X + NODE_W + LEFT;
const height = Math.max(treeBottom, ...shots.map((s) => pos.get(s.m.id)!.y + NODE_H)) + 40;

// Lines from each requirement to the node it unlocks. "Either/any of" groups are dashed.
const path = (a: string, b: string) => {
  const p = pos.get(a)!, q = pos.get(b)!;
  const x1 = p.x + NODE_W, y1 = p.y + NODE_H / 2, x2 = q.x, y2 = q.y + NODE_H / 2;
  const k = Math.max(40, (x2 - x1) * 0.5);
  return `M${x1} ${y1} C${x1 + k} ${y1} ${x2 - k} ${y2} ${x2} ${y2}`;
};
// Moonshots share one x, so a moonshot-to-moonshot line loops out to the right of the column.
const msLoop = (a: string, b: string) => {
  const p = pos.get(a)!, q = pos.get(b)!;
  const x = MS_X + NODE_W, y1 = p.y + NODE_H / 2, y2 = q.y + NODE_H / 2;
  const k = Math.min(36, 14 + Math.abs(y2 - y1) / 40);
  return `M${x} ${y1} C${x + k} ${y1} ${x + k} ${y2} ${x} ${y2}`;
};
// "Long" lines (more than two columns, across lanes and more than one column, or skipping a lane) are drawn faint until highlighted.
const isLong = (a: string, b: string) => {
  const A = byId.get(a), B = byId.get(b);
  if (!A || !B) return true;
  const span = depth.get(b)! - depth.get(a)!;
  const lanesApart = Math.abs(laneIndex.get(A.branch)! - laneIndex.get(B.branch)!);
  return span > 2 || (span > 1 && A.branch !== B.branch) || lanesApart > 1; // skips more than one lane: faint until highlighted
};
const edges: { from: string; to: string; d: string; alt: boolean; ms: boolean; long: boolean }[] = [];
for (const n of tree.nodes) {
  for (const g of n.requiresGroups as { kind: string; ids: string[] }[]) {
    for (const id of g.ids) if (pos.has(id)) edges.push({ from: id, to: n.id, d: path(id, n.id), alt: g.kind !== 'all', ms: false, long: isLong(id, n.id) });
  }
}
// Moonshot needs. `builds` holds node IDs and other moonshot IDs; every moonshot has a position by now.
for (const { m } of shots) {
  for (const id of m.builds.filter((x) => pos.has(x))) {
    const fromShot = pos.get(id)!.x === MS_X;
    edges.push({ from: id, to: m.id, d: fromShot ? msLoop(id, m.id) : path(id, m.id), alt: false, ms: true, long: true });
  }
}

// Requires text for the popup, e.g. "R-COM1 or R-COM3, R-SEC1" or "two of X-2, X-3, X-4".
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five'];
function reqParts(n: N): (string | { id: string })[] {
  const out: (string | { id: string })[] = [];
  (n.requiresGroups as { kind: string; n?: number; ids: string[]; text?: string[]; note?: string }[]).forEach((g, gi) => {
    if (gi > 0) out.push(', ');
    if (g.kind === 'atLeast') out.push(`${WORDS[g.n ?? 0] ?? g.n} of `);
    const items = [...g.ids.map((id) => ({ id })), ...(g.text ?? [])];
    items.forEach((it, i) => { if (i > 0) out.push(g.kind === 'any' ? ' or ' : ', '); out.push(it); });
    if (g.note) out.push(` (${g.note})`);
  });
  return out;
}
// Moonshot needs: node and moonshot IDs, then any free text from the source table (e.g. "+ partner adoption").
function shotReq(m: (typeof tree.moonshots)[number]): (string | { id: string })[] {
  const out: (string | { id: string })[] = [];
  m.builds.forEach((id, i) => { if (i) out.push(', '); out.push({ id }); });
  if (m.needs.text) { if (out.length) out.push(', '); out.push(m.needs.text); }
  return out;
}

// Everything the popup needs, in one small JSON blob.
const data = {
  issues: site.links.techtreeIssues,
  apply: nav.apply.href,
  items: Object.fromEntries([
    ...tree.nodes.map((n) => [n.id, {
      kind: 'node', name: n.name, branch: n.branch, status: n.status, brief: n.brief, github: n.github, lead: n.lead, team: n.team,
      req: reqParts(n), unlocks: [...n.unlocks.filter((u) => pos.has(u))], enables: n.enables || '', needed: n.neededBy.total,
    }]),
    ...shots.map(({ m }) => [m.id, {
      kind: 'moonshot', name: m.title, brief: m.brief || m.summary, github: m.github, lead: m.lead, team: m.team,
      req: shotReq(m), unlocks: [], progress: m.progress,
    }]),
  ]),
};

const STATUS: Record<string, string> = { available: 'Available', locked: 'Locked', 'in-progress': 'In progress', done: 'Done' };
const cols = Array.from({ length: maxDepth + 1 }, (_, i) => i);

// DOM order = reading and Tab order: lane by lane, column by column, top to bottom. Moonshots last.
const visualNodes = [...tree.nodes].sort((a, b) =>
  laneIndex.get(a.branch)! - laneIndex.get(b.branch)! || depth.get(a.id)! - depth.get(b.id)! || pos.get(a.id)!.y - pos.get(b.id)!.y);
const visualShots = [...shots].sort((a, b) => pos.get(a.m.id)!.y - pos.get(b.m.id)!.y);
---
<section class="tm" aria-labelledby="tm-h" data-tree hidden style={`--w:${width}`}>
  <h2 id="tm-h" class="visually-hidden">Tech tree map</h2>
  <div class="tm-main">
    <div class="tm-bar">
      <label class="tm-search"><span class="visually-hidden">Find a node</span><input type="search" placeholder="Name, ID or science" autocomplete="off" data-q /></label>
      <label class="tm-lane"><span class="visually-hidden">Jump to branch</span>
        <select data-lane>
          <option value="">Branch…</option>
          {lanes.map((l) => <option value={l.slug}>{l.name}</option>)}
          <option value="moonshots">Moonshots</option>
        </select>
      </label>
      <label class="tm-check"><input type="checkbox" data-avail /> Available only</label>
      <button type="button" class="tm-next" data-ready title="Jump to the next node you can start now">Next ready</button>
      <div class="tm-zoom" role="group" aria-label="Zoom">
        <button type="button" data-zoom="-1" aria-label="Zoom out">−</button>
        <button type="button" data-zoom="fit" title="Fit the tree to the width of the screen">Fit</button>
        <button type="button" data-zoom="1" aria-label="Zoom in">+</button>
      </div>
    </div>
    <p class="tm-hint">
      <span class="tm-hint-how">Drag or scroll to move. Ctrl + scroll or pinch to zoom. <span class="tm-hint-kbd">Keyboard: Tab to the map, arrow keys to move, Enter for details.</span></span>
      <span class="tm-legend" aria-hidden="true"><span class="lg lg-up">needs</span><span class="lg lg-down">unlocks</span><span class="lg lg-alt">either / any of</span></span>
    </p>
    <p class="visually-hidden" role="status" aria-live="polite" data-announce></p>

    <div class="tm-body">
    <div class="tm-view" data-view tabindex="-1">
      <div class="tm-size" data-size style={`width:${width}px;height:${height}px`}>
        <!-- Pinned headers live outside the scaled world: sticky keeps them in view while panning. -->
        <div class="tm-colbar" aria-hidden="true">
          {cols.map((c) => <span class="tm-col" style={`--x:${LEFT + c * COL_W}`}><span class="tm-col-w">Step </span>{c + 1}</span>)}
        </div>
        <div class="tm-lanebar" aria-hidden="true">
          {lanes.map((l) => <span class="tm-lane-name" style={`--y:${l.top}`}>{l.name}<small>{l.progress}</small></span>)}
        </div>
        <div class="tm-world" data-world style={`width:${width}px;height:${height}px`}>
          {lanes.map((l, i) => (
            <div class="tm-lane-band" data-lane-id={l.slug} data-odd={i % 2 === 1 ? '' : undefined} style={`top:${l.top}px;height:${l.height}px;width:${MS_X - 24}px`}></div>
          ))}
          <div class="tm-lane-band tm-ms-band" data-lane-id="moonshots" style={`top:${TOP - 8}px;height:${height - TOP - 24}px;left:${MS_X - 16}px;width:${NODE_W + 32}px`}>
            <span class="tm-ms-name">Moonshots</span>
          </div>

          <svg class="tm-edges" width={width} height={height} viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
            {edges.map((e) => <path d={e.d} data-from={e.from} data-to={e.to} data-long={e.long ? '' : undefined} class:list={[{ alt: e.alt, ms: e.ms }]} />)}
          </svg>

          {visualNodes.map((n) => {
            const p = pos.get(n.id)!;
            return (
              <button type="button" class="tn" data-id={n.id} data-status={n.status} data-lane-of={slugOf(n.branch)} data-x={p.x} data-y={p.y}
                data-text={`${n.id} ${n.name} ${n.sciences}`.toLowerCase()} aria-haspopup="dialog"
                style={`left:${p.x}px;top:${p.y}px`} aria-label={`${n.id} ${n.name}, ${STATUS[n.status]}`}>
                <span class="tn-icon" aria-hidden="true"></span>
                <span class="tn-id">{n.id}</span>
                <span class="tn-name">{n.name.replace(/ \(.*\)$/, '')}</span>
                {n.status === 'available' && <span class="tn-ready" aria-hidden="true">Ready</span>}
              </button>
            );
          })}
          {visualShots.map(({ m }) => {
            const p = pos.get(m.id)!;
            const prog = m.progress.total ? `, ${m.progress.done} of ${m.progress.total} nodes done` : ', needs not yet broken into nodes';
            return (
              <button type="button" class="tn tn-ms" data-id={m.id} data-lane-of="moonshots" data-x={p.x} data-y={p.y}
                data-text={`${m.id} ${m.title} ${m.summary}`.toLowerCase()} aria-haspopup="dialog"
                style={`left:${p.x}px;top:${p.y}px`} aria-label={`Moonshot ${m.id} ${m.title}${prog}`}>
                <span class="tn-icon" aria-hidden="true"></span>
                <span class="tn-id">{m.id}</span>
                <span class="tn-name">{m.title}</span>
              </button>
            );
          })}
        </div>
      </div>
    </div>

  <div class="tm-pop" role="dialog" aria-modal="false" aria-labelledby="tm-pop-h" data-pop hidden>
    <button type="button" class="tm-close" data-close aria-label="Close">×</button>
    <p class="tm-pop-meta"><span class="tn-id" data-p-id></span><span class="status" data-p-status></span></p>
    <h3 id="tm-pop-h" data-p-name></h3>
    <p class="tm-pop-brief" data-p-brief></p>
    <dl class="tm-pop-dl">
      <div data-p-people-row><dt>Who's on it</dt><dd data-p-people></dd></div>
      <div><dt data-p-req-label>Requires</dt><dd data-p-req></dd></div>
      <div data-p-unl-row><dt>Unlocks</dt><dd data-p-unl></dd></div>
    </dl>
    <p class="tm-pop-actions"><a class="btn btn-primary" data-p-link></a><a class="tm-more" data-p-more></a><a class="tm-more" data-p-how href="/docs/claim-a-node/" hidden>How claiming works</a></p>
  </div>
    </div>
  </div>
  <script type="application/json" data-tree-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
</section>

<script>
  type Part = string | { id: string };
  type Item = {
    kind: 'node' | 'moonshot'; name: string; branch?: string; status?: string; brief: string; github: string | null;
    lead: string | null; team: string[]; req: Part[]; unlocks: string[]; enables?: string; needed?: number;
    progress?: { total: number; done: number };
  };
  const root = document.querySelector<HTMLElement>('[data-tree]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const parsed = JSON.parse(root.querySelector('[data-tree-data]')!.textContent!) as { items: Record<string, Item>; issues: string | null; apply: string };
    const { issues, apply } = parsed;
    // Prototype-free lookup: a hash like #constructor must not find Object.prototype members.
    const items: Record<string, Item> = Object.assign(Object.create(null), parsed.items);
    const view = root.querySelector<HTMLElement>('[data-view]')!;
    const size = root.querySelector<HTMLElement>('[data-size]')!;
    const world = root.querySelector<HTMLElement>('[data-world]')!;
    const pop = root.querySelector<HTMLElement>('[data-pop]')!;
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const avail = root.querySelector<HTMLInputElement>('[data-avail]')!;
    const laneSel = root.querySelector<HTMLSelectElement>('[data-lane]')!;
    const announce = root.querySelector<HTMLElement>('[data-announce]')!;
    const W = parseFloat(world.style.width), H = parseFloat(world.style.height);
    const nodeList = [...root.querySelectorAll<HTMLButtonElement>('.tn')]; // DOM order = reading order
    const nodes = new Map(nodeList.map((b) => [b.dataset.id!, b]));
    const paths = [...root.querySelectorAll<SVGPathElement>('.tm-edges path')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Wide screens dock the popup beside the map; everything else gets a bottom sheet. Mirrors the CSS media query.
    const DOCK_Q = '(min-width: 861px), (min-width: 641px) and (max-height: 500px)';
    const isSheet = () => !matchMedia(DOCK_Q).matches;

    // Graph for highlighting: what a node needs (all the way down) and what it opens up.
    const edgeEnds = paths.map((p) => [p.dataset.from!, p.dataset.to!] as const);
    const parents = new Map<string, string[]>(), children = new Map<string, string[]>();
    for (const [a, b] of edgeEnds) {
      parents.set(b, [...(parents.get(b) ?? []), a]);
      children.set(a, [...(children.get(a) ?? []), b]);
    }
    const walk = (start: string, next: Map<string, string[]>) => {
      const seen = new Set<string>(); const stack = [...(next.get(start) ?? [])];
      while (stack.length) { const id = stack.pop()!; if (seen.has(id)) continue; seen.add(id); stack.push(...(next.get(id) ?? [])); }
      return seen;
    };

    // ---- Zoom (native scrolling does the panning, so touch, wheel and keyboard all work)
    let scale = 1;
    let sized = false; // set once the map has been shown and given its starting zoom
    const MIN = () => Math.min(1, Math.max(0.15, Math.min(view.clientWidth / W, view.clientHeight / H))); // whole-tree overview
    const FIT = () => Math.min(1, Math.max(0.3, view.clientWidth / W)); // whole width, scroll down for the rest
    function setScale(s: number, px = view.clientWidth / 2, py = view.clientHeight / 2) {
      s = Math.min(1.6, Math.max(MIN(), s));
      const cx = (view.scrollLeft + px) / scale, cy = (view.scrollTop + py) / scale;
      scale = s;
      world.style.transform = `scale(${s})`;
      size.style.width = `${W * s}px`;
      size.style.height = `${H * s}px`;
      view.scrollLeft = cx * s - px;
      view.scrollTop = cy * s - py;
      root.style.setProperty('--tm-scale', String(s));
      root.dataset.lod = s < 0.6 ? 'far' : 'near'; // far zoom: IDs and status colours only
    }
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => {
      const z = b.dataset.zoom!;
      if (z === 'fit') { setScale(FIT()); view.scrollTo({ left: 0, top: 0 }); }
      else setScale(scale * (z === '1' ? 1.25 : 0.8));
      announce.textContent = `Zoom ${Math.round(scale * 100)} percent`;
    }));
    view.addEventListener('wheel', (e) => {
      if (!e.ctrlKey && !e.metaKey) return; // plain wheel scrolls; ctrl/cmd or trackpad pinch zooms
      e.preventDefault();
      const r = view.getBoundingClientRect();
      setScale(scale * Math.exp(-e.deltaY * 0.0025), e.clientX - r.left, e.clientY - r.top);
    }, { passive: false });

    // Two-finger pinch on touch screens.
    let pinch: { d: number; s: number } | null = null;
    const dist = (t: TouchList) => Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
    view.addEventListener('touchstart', (e) => { if (e.touches.length === 2) pinch = { d: dist(e.touches), s: scale }; }, { passive: true });
    view.addEventListener('touchmove', (e) => {
      if (!pinch || e.touches.length !== 2) return;
      e.preventDefault();
      const r = view.getBoundingClientRect();
      const mx = (e.touches[0].clientX + e.touches[1].clientX) / 2 - r.left, my = (e.touches[0].clientY + e.touches[1].clientY) / 2 - r.top;
      setScale(pinch.s * (dist(e.touches) / pinch.d), mx, my);
    }, { passive: false });
    view.addEventListener('touchend', () => { pinch = null; });

    // Drag with a mouse to pan, starting on the background or on a node. A plain click still opens the node:
    // we only take over the pointer once it has really moved, then swallow the click that follows.
    let drag: { x: number; y: number; l: number; t: number; moved: boolean; id: number; onNode: boolean } | null = null;
    let suppressClick = false;
    view.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, y: e.clientY, l: view.scrollLeft, t: view.scrollTop, moved: false, id: e.pointerId, onNode: !!(e.target as Element).closest('.tn') };
    });
    view.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      if (!drag.moved && Math.abs(dx) + Math.abs(dy) > 4) {
        drag.moved = true;
        view.setPointerCapture(drag.id);
        view.classList.add('is-dragging');
      }
      if (drag.moved) { view.scrollLeft = drag.l - dx; view.scrollTop = drag.t - dy; }
    });
    const endDrag = () => {
      if (drag?.moved) { suppressClick = true; window.setTimeout(() => { suppressClick = false; }, 0); }
      else if (drag && !drag.onNode) closePop(false); // click on the background closes the popup
      drag = null; view.classList.remove('is-dragging');
    };
    view.addEventListener('pointerup', endDrag);
    view.addEventListener('pointercancel', () => { drag = null; view.classList.remove('is-dragging'); });
    view.addEventListener('click', (e) => { if (suppressClick) { e.stopPropagation(); e.preventDefault(); } }, { capture: true });

    // The part of the map box that is actually on screen (the box can run past the bottom of the window).
    const visibleBand = () => {
      const v = view.getBoundingClientRect();
      return { v, top: Math.max(v.top, 0), bottom: Math.min(v.bottom, window.innerHeight) };
    };
    // If most of the map box is off screen (short landscape screens), scroll the page so it is in view.
    function showMapBox() {
      const { v, top, bottom } = visibleBand();
      if (bottom - top >= Math.min(v.height, 300)) return;
      const H = window.innerHeight;
      const dy = v.height <= H - 16 && v.top >= 0 ? v.bottom - H + 8 : v.top - 8;
      window.scrollBy({ top: dy, behavior: 'instant' as ScrollBehavior });
    }
    function centerOn(id: string, smooth = true) {
      const b = nodes.get(id); if (!b) return;
      showMapBox();
      const { v, top, bottom } = visibleBand();
      const pinned = 26; // step header strip
      const cy = (Math.max(top, v.top + pinned) + bottom) / 2 - v.top; // centre of the visible part, in box coordinates
      const x = (b.offsetLeft + b.offsetWidth / 2) * scale - view.clientWidth / 2;
      const y = (b.offsetTop + b.offsetHeight / 2) * scale - cy;
      view.scrollTo({ left: x, top: y, behavior: smooth && !reduce ? 'smooth' : 'auto' });
    }
    // Pan only if the node is (nearly) out of view.
    function ensureVisible(id: string) {
      const b = nodes.get(id)!.getBoundingClientRect(), { v, top, bottom } = visibleBand();
      if (b.left < v.left + 8 || b.right > v.right - 8 || b.top < top + 36 || b.bottom > bottom - 8) centerOn(id);
    }

    // ---- Highlight a node's path. Only elements whose state changed are touched (cheap on hover).
    let selected: string | null = null;
    let hlNodes = new Map<string, string>(), hlPaths = new Map<number, string>();
    function highlight(id: string | null) {
      root.classList.toggle('has-focus', !!id);
      const nextN = new Map<string, string>(), nextP = new Map<number, string>();
      if (id) {
        const up = walk(id, parents), down = new Set(children.get(id) ?? []);
        nextN.set(id, 'self');
        up.forEach((k) => nextN.set(k, 'up'));
        down.forEach((k) => { if (!nextN.has(k)) nextN.set(k, 'down'); });
        edgeEnds.forEach(([a, b], i) => {
          const v = (b === id || up.has(b)) && (a === id || up.has(a)) ? 'up' : a === id ? 'down' : '';
          if (v) nextP.set(i, v);
        });
      }
      hlNodes.forEach((_, k) => { if (!nextN.has(k)) nodes.get(k)?.removeAttribute('data-hl'); });
      nextN.forEach((v, k) => { if (hlNodes.get(k) !== v) nodes.get(k)!.dataset.hl = v; });
      hlPaths.forEach((_, i) => { if (!nextP.has(i)) paths[i].removeAttribute('data-hl'); });
      nextP.forEach((v, i) => { if (hlPaths.get(i) !== v) paths[i].dataset.hl = v; });
      hlNodes = nextN; hlPaths = nextP;
    }
    // Hover waits a moment so sweeping the mouse across the map does not restyle everything.
    let hoverT: number | undefined;
    const hover = (id: string | null) => { clearTimeout(hoverT); hoverT = window.setTimeout(() => { if (!selected) highlight(id); }, 60); };
    nodes.forEach((b, id) => {
      b.addEventListener('mouseenter', () => hover(id));
      b.addEventListener('mouseleave', () => hover(null));
      b.addEventListener('focus', () => { if (!selected) highlight(id); });
      b.addEventListener('blur', () => { if (!selected) highlight(null); });
      b.addEventListener('click', () => openPop(id, false));
    });

    // ---- Keyboard: one Tab stop for the whole map (roving tabindex); arrows move between nodes.
    const setStop = (b: HTMLElement) => nodeList.forEach((x) => { x.tabIndex = x === b ? 0 : -1; });
    setStop(nodeList.find((b) => b.dataset.status === 'available') ?? nodeList[0]);
    nodeList.forEach((b) => b.addEventListener('focus', () => setStop(b)));
    const STEP: Record<string, [number, number]> = { ArrowRight: [1, 0], ArrowLeft: [-1, 0], ArrowDown: [0, 1], ArrowUp: [0, -1] };
    const centre = (b: HTMLElement) => { const r = b.getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height / 2]; };
    view.addEventListener('keydown', (e) => {
      const from = (e.target as HTMLElement).closest<HTMLButtonElement>('.tn');
      if (!from || e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === 'Home' || e.key === 'End') { // first / last node in this lane
        const lane = nodeList.filter((b) => b.dataset.laneOf === from.dataset.laneOf && !b.inert);
        e.preventDefault();
        (e.key === 'Home' ? lane[0] : lane[lane.length - 1])?.focus();
        return;
      }
      const step = STEP[e.key];
      if (!step) return;
      e.preventDefault();
      const [x0, y0] = centre(from);
      let best: HTMLButtonElement | null = null, score = Infinity;
      for (const b of nodeList) {
        if (b === from || b.inert) continue;
        const [x, y] = centre(b), dx = x - x0, dy = y - y0;
        if (step[0] * dx + step[1] * dy <= 0) continue; // only nodes in the arrow's direction
        const along = Math.abs(step[0] ? dx : dy), across = Math.abs(step[0] ? dy : dx);
        const s = along + across * 2;
        if (s < score) { score = s; best = b; }
      }
      best?.focus(); // focus() scrolls the node into view (scroll-padding keeps it clear of the pinned headers)
    });

    // ---- Popup
    const $ = (k: string) => pop.querySelector<HTMLElement>(`[data-${k}]`)!;
    const STATUS: Record<string, string> = { available: 'Available', locked: 'Locked', 'in-progress': 'In progress', done: 'Done' };
    // A link to another node. In "Requires" it also carries that node's status (dot via CSS, words in the name).
    const idLink = (id: string, withStatus: boolean) => {
      const a = document.createElement('a');
      a.href = `#${id}`; a.textContent = id; a.className = 'tn-id';
      const it = items[id];
      a.title = it?.name ?? id;
      const st = withStatus && it?.kind === 'node' ? it.status : undefined;
      if (st) a.dataset.s = st;
      a.setAttribute('aria-label', `${id} ${it?.name ?? ''}${st ? `, ${STATUS[st]}` : ''}`.trim());
      return a;
    };
    function fill(el: HTMLElement, parts: Part[], empty: string, withStatus = false) {
      const out: Node[] = [];
      for (const p of parts) {
        if (typeof p !== 'string') { out.push(items[p.id] ? idLink(p.id, withStatus) : document.createTextNode(p.id)); continue; }
        // Keep a separating comma on the same line as the link before it.
        const last = out[out.length - 1];
        if (p.startsWith(',') && last instanceof HTMLAnchorElement) {
          const nw = document.createElement('span'); nw.className = 'nw';
          nw.append(last, ',');
          out[out.length - 1] = nw;
          if (p.length > 1) out.push(document.createTextNode(p.slice(1)));
        } else out.push(document.createTextNode(p));
      }
      el.replaceChildren(...(out.length ? out : [document.createTextNode(empty)]));
    }
    let opener: HTMLElement | null = null;
    function openPop(id: string, fromHash: boolean, center = fromHash) {
      const it = items[id]; if (!it) return;
      selected = id;
      highlight(id);
      nodes.forEach((b, k) => { if (k === id) b.setAttribute('aria-expanded', 'true'); else b.removeAttribute('aria-expanded'); });
      opener = nodes.get(id) ?? null;
      $('p-id').textContent = id;
      const st = $('p-status');
      if (it.kind === 'moonshot') {
        st.dataset.s = 'moonshot';
        const p = it.progress!;
        st.textContent = p.total ? `Moonshot · ${p.done} of ${p.total} nodes done` : 'Moonshot · not yet broken into nodes';
      } else { st.dataset.s = it.status!; st.textContent = STATUS[it.status!]; }
      $('p-name').textContent = it.name;
      $('p-brief').textContent = it.brief || (it.kind === 'node' ? `Part of the ${it.branch} branch.` : '');
      $('p-brief').hidden = !$('p-brief').textContent;
      const people = [it.lead && `Lead: ${it.lead}`, it.team.length && `Team: ${it.team.join(', ')}`].filter(Boolean).join(' · ');
      const noOne = it.kind === 'moonshot' ? 'Not listed yet.'
        : it.status === 'available' ? 'No one yet. You could be first.'
        : it.status === 'locked' ? 'No one yet.'
        : 'Not listed yet.';
      $('p-people').textContent = people || noOne;
      $('p-req-label').textContent = it.kind === 'moonshot' ? 'Needs' : 'Requires';
      fill($('p-req'), it.req, 'Nothing. Start here.', true);
      // Unlocks: linked nodes, then the free-text "enables" from the source table.
      const unl: Part[] = it.unlocks.flatMap((u, i) => (i ? [', ', { id: u }] : [{ id: u }]));
      if (it.enables) unl.push(unl.length ? `, ${it.enables}` : it.enables);
      fill($('p-unl'), unl, 'Nothing yet');
      $('p-unl-row').hidden = it.kind === 'moonshot';

      // Call to action, by case. The second link is "Full details" (nodes) or the GitHub link (moonshots).
      const link = $('p-link') as HTMLAnchorElement, more = $('p-more') as HTMLAnchorElement;
      const firstUnmet = it.req.find((p): p is { id: string } => typeof p !== 'string' && items[p.id]?.kind === 'node' && items[p.id].status !== 'done');
      more.hidden = false;
      ($('p-how') as HTMLElement).hidden = !(it.kind === 'node' && it.status === 'available'); // claiming guide, only where /claim applies
      if (it.kind === 'moonshot') {
        link.href = `/moonshots/#${id}`; link.textContent = 'Read about this moonshot';
        if (it.github) { more.href = it.github; more.textContent = 'See the work on GitHub'; } else more.hidden = true;
      } else {
        more.href = `?view=list#${id}`; more.textContent = 'Full details';
        if (it.github) { link.href = it.github; link.textContent = 'See the work on GitHub'; }
        else if (it.status === 'locked' && firstUnmet) { link.href = `#${firstUnmet.id}`; link.textContent = 'See what it needs'; }
        else if (issues && it.status === 'available') {
          const u = new URL(`${issues.replace(/\/$/, '')}/issues/new`);
          u.searchParams.set('title', `[${id}] ${it.name}`);
          u.searchParams.set('labels', 'techtree');
          link.href = u.toString(); link.textContent = 'Start this on GitHub';
        } else { link.href = apply; link.textContent = 'Apply to work on this'; }
      }

      pop.hidden = false;
      root.classList.add('has-pop');
      if (isSheet()) {
        if (center) centerOn(id, false);
        revealAboveSheet(id);
      } else {
        if (center) centerOn(id); else ensureVisible(id);
        const pr = pop.getBoundingClientRect(); // short screens: bring the docked panel into view, but never nudge the page when its top is already visible
        if (pr.top < 0 || pr.top > window.innerHeight - 160) pop.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
      }
      history.replaceState(null, '', `${location.pathname}${location.search}#${id}`);
      $('p-name').setAttribute('tabindex', '-1');
      if (!fromHash) ($('p-name') as HTMLElement).focus({ preventScroll: true });
    }
    // Phone sheet covers the bottom of the screen: scroll the page (then the map) so the tapped node sits above it.
    function revealAboveSheet(id: string) {
      const b = nodes.get(id)!.getBoundingClientRect();
      const sheetTop = pop.getBoundingClientRect().top - 12;
      if (b.top < 64) { window.scrollBy({ top: b.top - 64, behavior: 'instant' as ScrollBehavior }); return; }
      let need = b.bottom - sheetTop;
      if (need <= 0) return;
      const y0 = window.scrollY;
      window.scrollBy({ top: need, behavior: 'instant' as ScrollBehavior });
      need -= window.scrollY - y0;
      if (need > 0) view.scrollTop += need; // page could not scroll further: move the map instead
    }
    function closePop(returnFocus = true) {
      if (pop.hidden) return;
      const hadFocus = pop.contains(document.activeElement);
      pop.hidden = true; selected = null;
      root.classList.remove('has-pop');
      nodes.forEach((b) => b.removeAttribute('aria-expanded'));
      history.replaceState(null, '', location.pathname + location.search);
      if (returnFocus && hadFocus) opener?.focus({ preventScroll: true });
      highlight(null); // after focus(): the node's focus handler would otherwise light the path again
    }
    $('close').addEventListener('click', () => closePop());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    pop.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a) return;
      e.preventDefault();
      openPop(decodeURIComponent(a.hash.slice(1)), false, true);
    });

    // ---- Find, filter, jump
    let t: number | undefined, panT: number | undefined;
    function filter(pan = false) {
      const toks = q.value.toLowerCase().split(/[\s,]+/).filter(Boolean);
      const active = toks.length > 0 || avail.checked;
      const hitIds = new Set<string>();
      nodes.forEach((b, id) => {
        const ok = toks.every((k) => b.dataset.text!.includes(k)) && (!avail.checked || b.dataset.status === 'available');
        b.toggleAttribute('data-dim', active && !ok);
        b.toggleAttribute('data-hit', active && ok);
        b.inert = active && !ok; // filtered-out nodes leave the tab order and the accessibility tree
        if (active && ok) hitIds.add(id);
      });
      // Lines stay visible only between two matches.
      edgeEnds.forEach(([a, b], i) => paths[i].toggleAttribute('data-keep', active && hitIds.has(a) && hitIds.has(b)));
      // Keep one Tab stop alive: if the current one went inert, hand it to the first node left.
      if (nodeList.find((b) => b.tabIndex === 0)?.inert) { const f = nodeList.find((b) => !b.inert); if (f) setStop(f); }
      root.classList.toggle('is-filtering', active);
      // Leftmost match first (then topmost).
      const first = [...hitIds].map((id) => nodes.get(id)!).sort((a, b) => +a.dataset.x! - +b.dataset.x! || +a.dataset.y! - +b.dataset.y!)[0]?.dataset.id ?? null;
      clearTimeout(t);
      t = window.setTimeout(() => { announce.textContent = active ? `${hitIds.size} matching nodes` : ''; }, 400);
      if (pan) { clearTimeout(panT); panT = window.setTimeout(() => { if (first && toks.length) centerOn(first); }, 350); }
      return first;
    }
    q.addEventListener('input', () => filter(true));
    q.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const f = filter(); if (f) { openPop(f, false, true); } } });
    avail.addEventListener('change', () => filter());
    laneSel.addEventListener('change', () => {
      const band = root.querySelector<HTMLElement>(`[data-lane-id="${laneSel.value}"]`);
      if (band) {
        view.scrollTo({ left: band.offsetLeft * scale, top: Math.max(0, band.offsetTop * scale - 34), behavior: reduce ? 'auto' : 'smooth' });
        announce.textContent = `Showing ${laneSel.selectedOptions[0].text}`;
      }
      laneSel.value = '';
    });

    // "Next ready": cycle through the nodes you can start now, left to right.
    const ready = nodeList.filter((b) => b.dataset.status === 'available').sort((a, b) => +a.dataset.x! - +b.dataset.x! || +a.dataset.y! - +b.dataset.y!);
    let readyAt = -1;
    root.querySelector<HTMLButtonElement>('[data-ready]')!.addEventListener('click', () => {
      if (!ready.length) return;
      readyAt = (readyAt + 1) % ready.length;
      const id = ready[readyAt].dataset.id!;
      openPop(id, false, true);
      announce.textContent = `Ready node ${readyAt + 1} of ${ready.length}`;
    });

    // ---- Public hooks for the page (view toggle and #ID links)
    root.addEventListener('tm:show', () => {
      if (!sized) { sized = true; setScale(view.clientWidth < 640 ? 0.75 : 1, 0, 0); }
      const id = decodeURIComponent(location.hash.slice(1));
      if (items[id]) openPop(id, true);
    });
    root.addEventListener('tm:hash', () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (items[id]) { if (id !== selected || pop.hidden) openPop(id, true); }
      else if (!pop.hidden) closePop(false);
    });
    window.addEventListener('resize', () => { if (sized) setScale(scale); });
  }
</script>

<style>
  .tm { position: relative; margin-block: var(--space-4) var(--space-8); --tm-scale: 1; --tm-h: clamp(24rem, calc(100svh - 12rem), 52rem); }
  .tm[hidden] { display: none; }
  .tm-main { min-width: 0; }
  .tm-pop-dl :global(.nw) { display: inline-block; white-space: nowrap; } /* link + its comma stay together */
  .tm-bar { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; }
  .tm-search { flex: 1 1 16rem; }
  .tm-search input, .tm-lane select { font: inherit; width: 100%; min-height: var(--tap); padding: var(--space-2) var(--space-3); border: 1px solid var(--line-control); border-radius: var(--radius-md); background: var(--white); color: var(--ink); }
  .tm-lane { flex: 0 1 13rem; }
  .tm-check { display: flex; gap: var(--space-2); align-items: center; min-height: var(--tap); font-size: var(--step--1); }
  .tm-check input { width: 1.2rem; height: 1.2rem; margin: 0; }
  .tm-next { font: inherit; font-size: var(--step--1); font-weight: var(--weight-ui); min-height: var(--tap); padding: 0 var(--space-3); border: 1px solid var(--available); border-radius: var(--radius-md); background: var(--white); color: var(--available); cursor: pointer; }
  .tm-next:hover { background: var(--sky); }
  .tm-zoom { display: inline-flex; border: 1px solid var(--line-control); border-radius: var(--radius-md); overflow: hidden; margin-left: auto; }
  .tm-zoom button { font: inherit; font-weight: var(--weight-ui); min-width: var(--tap); min-height: var(--tap); border: 0; background: var(--white); color: var(--ink); cursor: pointer; padding: 0 var(--space-3); }
  .tm-zoom button + button { border-left: 1px solid var(--line-control); }
  .tm-zoom button:hover { background: var(--sky); }
  .tm-zoom button:focus-visible { outline-offset: -3px; } /* the group clips its children, so draw the ring inside */
  .tm-hint { max-width: none; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); align-items: center; font-size: var(--step--1); color: var(--ink-muted); margin: var(--space-2) 0; }
  .tm-hint-how { flex: 1 1 28rem; }
  .tm-legend { display: inline-flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); }
  .lg::before { content: ''; display: inline-block; width: 1.4rem; margin-right: 0.35rem; vertical-align: middle; border-top: 3px solid var(--chart); }
  .lg-up::before { border-top-color: var(--airspace); }
  .lg-alt::before { border-top: 3px dashed var(--ink-muted); }

  .tm-view {
    position: relative; overflow: auto; height: var(--tm-h);
    border: 1px solid var(--line-control); border-radius: var(--radius-sm);
    background-color: var(--paper);
    background-image: radial-gradient(circle, var(--contour) 1px, transparent 1.2px);
    background-size: 24px 24px;
    scroll-padding: 40px 16px 16px; /* keep a focused node clear of the pinned step headers */
    cursor: grab; overscroll-behavior: contain; touch-action: pan-x pan-y;
  }
  .tm-view.is-dragging { cursor: grabbing; user-select: none; }
  .tm-size { position: relative; }
  .tm-world { position: absolute; top: 0; left: 0; transform-origin: 0 0; }

  /* Pinned headers: zero-height sticky strips, so they stay put while the world scrolls and scales under them. */
  .tm-colbar { position: sticky; top: 0; z-index: 3; height: 0; width: calc(var(--w) * 1px * var(--tm-scale)); }
  .tm-colbar::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 26px; background: rgb(246 249 251 / 0.94); border-bottom: 1px solid var(--contour); }
  .tm-col { position: absolute; top: 5px; left: calc(var(--x) * 1px * var(--tm-scale)); width: calc(200px * var(--tm-scale)); text-align: center; font-size: 0.75rem; line-height: 16px; font-weight: var(--weight-ui); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap; }
  .tm-lanebar { position: sticky; left: 0; z-index: 2; width: 0; height: 0; }
  .tm-lane-name {
    position: absolute; left: 14px; top: calc(var(--y) * 1px * var(--tm-scale) + 4px); max-width: min(34rem, 90vw);
    padding: 1px 8px; border-radius: 999px; background: rgb(246 249 251 / 0.88); white-space: nowrap;
    font-family: var(--font-display); font-weight: var(--weight-heading); font-stretch: var(--stretch-heading); font-size: 0.85rem; line-height: 20px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--chart-deep);
  }
  .tm-lane-name small { margin-left: 0.6em; font-family: var(--font-body); font-weight: var(--weight-regular); font-stretch: 100%; font-size: 0.75rem; letter-spacing: 0; text-transform: none; color: var(--ink-muted); }

  .tm-lane-band { position: absolute; left: 8px; border-radius: var(--radius-sm); }
  .tm-lane-band[data-odd] { background: rgb(42 95 168 / 0.04); }
  .tm-ms-band { background: linear-gradient(180deg, var(--accent-tint), rgb(246 228 238 / 0.35)); border: 1px dashed rgb(166 30 110 / 0.35); }
  .tm-ms-name { position: absolute; top: 18px; left: 16px; font-family: var(--font-display); font-weight: var(--weight-heading); font-stretch: var(--stretch-heading); font-size: 0.95rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--airspace); }

  /* Lines: short ones are clear, long ones (and moonshot needs) stay faint until a node is hovered or opened. */
  .tm-edges { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
  .tm-edges path { fill: none; stroke: var(--line-control); stroke-width: 1.5; opacity: 0.5; }
  .tm-edges path[data-long] { opacity: 0.14; }
  .tm-edges path.alt { stroke-dasharray: 5 4; }
  .tm-edges path.ms { stroke: var(--airspace); opacity: 0.07; }
  .tm.is-filtering .tm-edges path { opacity: 0.04; }
  .tm.is-filtering .tm-edges path[data-keep] { opacity: 0.6; }
  .tm.has-focus .tm-edges path { opacity: 0.05; }
  .tm.has-focus .tm-edges path[data-hl='up'] { stroke: var(--airspace); stroke-width: 2.5; opacity: 1; }
  .tm.has-focus .tm-edges path[data-hl='down'] { stroke: var(--chart); stroke-width: 2.5; opacity: 1; }

  .tn {
    position: absolute; width: 200px; height: 56px; display: grid; grid-template-columns: 22px 1fr; grid-template-rows: auto 1fr; column-gap: 8px;
    align-items: center; text-align: left; padding: 6px 10px; font: inherit; color: var(--ink); cursor: pointer;
    background: var(--white); border: 2px solid var(--line-control); border-radius: 8px;
    box-shadow: 0 1px 2px rgb(19 35 63 / 0.08);
    transition: box-shadow var(--dur-feedback) var(--ease-out), opacity var(--dur-state) var(--ease-out);
  }
  .tn:hover { box-shadow: var(--shadow-overlay); }
  /* Rings are drawn at a constant on-screen width: divide by the zoom so they do not shrink with the map. */
