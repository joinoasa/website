---
// Docs header/menu: links back to the main site, Apply, then the configured social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { nav } from '../../config/site';

const links = [{ href: '/', label: 'Home' }, ...nav.primary.filter((l) => l.href !== '/docs/')];
// Between the mobile and wide breakpoints the header is tight, so only these stay visible.
const keep = new Set(['/', '/techtree/']);
---
<nav class="site-nav" aria-label="OASA site">
  <ul>
    {links.map((l) => (
      <li class={l.href === '/' ? 'home' : keep.has(l.href) ? undefined : 'extra'}><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
  <a class="apply" href={nav.apply.href}>{nav.apply.short}</a>
</nav>
<Default {...Astro.props} />

<style>
  .site-nav { display: flex; align-items: center; gap: 1rem; }
  ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  li a { display: inline-flex; align-items: center; min-height: 2.75rem; padding-inline: 0.5rem; color: var(--sl-color-gray-2); text-decoration: none; font-size: var(--sl-text-sm); white-space: nowrap; }
  li a:hover { color: var(--sl-color-white); }
  .apply { display: inline-flex; align-items: center; min-height: 2.75rem; padding-inline: 1rem; border-radius: 0.25rem; background: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 700; font-size: var(--sl-text-sm); text-decoration: none; white-space: nowrap; }
  :global(:root[data-theme='dark']) .apply { color: #0e1a30; }
  :global(:root[data-theme='light']) .apply { background: #e3a32c; color: #0b253a; }
  .apply:hover { filter: brightness(1.1); color: inherit; }

  /* Tight header between 50rem and 72rem: Home, Tech tree and Apply only. */
  @media (min-width: 50rem) and (max-width: 72rem) { .extra { display: none; } }

  @media (min-width: 50rem) and (max-width: 58rem) { .home { display: none; } }

  /* Mobile menu footer (below 50rem): vertical list with 44 px targets. */
  @media (max-width: 49.99rem) {
    .site-nav { flex-direction: column; align-items: stretch; gap: 0.25rem; width: 100%; }
    ul { flex-direction: column; gap: 0; }
    li a { width: 100%; padding-inline: 0; font-size: var(--sl-text-base); }
    .apply { justify-content: center; margin-block: 0.5rem; }
  }
</style>
