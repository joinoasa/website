---
import Default from '@astrojs/starlight/components/Footer.astro';
import { nav, contact, socialLinks } from '../../config/site';
---
<Default {...Astro.props}><slot /></Default>
<div class="site-footer">
  <nav aria-label="OASA site footer">
    {nav.footer.map((g) => (
      <div>
        <h2>{g.heading}</h2>
        <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    ))}
  </nav>
  <p class="contact">
    <a href={`mailto:${contact('general')}`}>{contact('general')}</a>
    {socialLinks.map((s) => <>{' · '}<a href={s.href} rel="me">{s.label}</a></>)}
  </p>
</div>

<style>
  .site-footer { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--sl-color-hairline); font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1.5rem; }
  h2 { font-size: var(--sl-text-sm); margin: 0 0 0.25rem; color: var(--sl-color-gray-2); font-family: var(--sl-font); font-stretch: 100%; letter-spacing: 0; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  a { color: var(--sl-color-gray-2); }
  a:hover { color: var(--sl-color-white); }
  .contact { margin: 1rem 0 0; }
  .contact a { display: inline-flex; align-items: center; min-height: 2.75rem; }
</style>
