---
import Default from '@astrojs/starlight/components/Head.astro';
import soraUrl from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { site } from '../../config/site';

const og = `${site.url}/og.png`;
---
<Default {...Astro.props}><slot /></Default>
{[soraUrl, interUrl].map((href) => (
  <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
))}
<meta property="og:site_name" content={site.shortName} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={og} />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content={site.themeColor} />
